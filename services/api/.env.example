PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

DATABASE_URL="postgresql://user:password@localhost:5432/trademind"

JWT_ACCESS_SECRET=replace_with_a_64_char_random_hex_string
JWT_REFRESH_SECRET=replace_with_a_64_char_random_hex_string

ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=30d

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_smtp_app_password

CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


BROKER_ENCRYPTION_KEY=replace_with_a_64_char_random_hex_string

GOOGLE_CLIENT_ID=your_google_oauth_client_id

RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
